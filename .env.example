# ─── Odoo Connection ──────────────────────────────────────────────────────────
# Base URL of your Odoo instance (no trailing slash)
ODOO_URL=https://your-odoo.example.com

# Odoo database name
ODOO_DB=your_database

# Odoo login username (email)
ODOO_USERNAME=admin@example.com

# Odoo API key (Settings > Technical > API Keys)
ODOO_API_KEY=your-odoo-api-key-here

# Request timeout in seconds (default: 30)
ODOO_TIMEOUT_SECONDS=30

# Max retry attempts on network failure (default: 3)
ODOO_MAX_RETRIES=3

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=LaVerde ERP AI Engine
APP_VERSION=6.0.0

# Environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode (never true in production)
DEBUG=false

# ─── Authentication ───────────────────────────────────────────────────────────
# Seed credentials — used ONCE at first startup to create the initial admin user.
# After the DB is seeded these values are no longer used for runtime authentication.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me-before-production

# Path to the local SQLite user store (relative to repo root)
USER_DB_PATH=data/users.db

# Session secret — REQUIRED in EVERY environment (>= 32 random characters).
# The app REFUSES TO START if this is empty or shorter than 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value.
SESSION_SECRET=

# Session cookie lifetime in seconds (default: 28800 = 8 hours)
SESSION_COOKIE_MAX_AGE=28800

# Company / user display name shown in the dashboard greeting and chat welcome screen.
# Example: DISPLAY_NAME=La Verde  →  "Good morning, La Verde" / "أهلاً La Verde"
# If empty, the name is derived from BASIC_AUTH_USERNAME (first segment before . or @).
# NOTE: changing this requires a server restart to take effect.
DISPLAY_NAME=La Verde

# ─── Cache ────────────────────────────────────────────────────────────────────
# How long to cache Odoo responses in seconds (default: 60)
CACHE_TTL_SECONDS=60

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty to deny all cross-origin
# requests — there is no wildcard fallback).
# "*" is accepted in development/staging but the app REFUSES TO START with "*"
# in this list when ENVIRONMENT=production — list explicit origins instead.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Per-IP rate limits (slowapi format: "N/period" where period = second|minute|hour)
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SUMMARY=30/minute
RATE_LIMIT_FOLLOWUP=30/minute
RATE_LIMIT_HTML=60/minute
RATE_LIMIT_HEALTH=600/minute

# ─── Security ─────────────────────────────────────────────────────────────────
# Content-Security-Policy header value
CSP_POLICY=default-src 'self'; style-src 'self' 'unsafe-inline'

# ─── AI Configuration ─────────────────────────────────────────────────────────
# Enable AI-powered features (lead prioritization, chat, daily briefing).
# Left false by default so a fresh checkout boots without an OpenAI key —
# flip to true and set OPENAI_API_KEY once you want AI features.
AI_ENABLED=false

# AI provider identifier (currently only "openai" is supported)
AI_PROVIDER=openai

# OpenAI API key — REQUIRED if AI_ENABLED=true. NEVER commit the real value.
OPENAI_API_KEY=

# OpenAI-compatible API base URL
OPENAI_BASE_URL=https://api.openai.com/v1

# Primary model used for AI features
AI_MODEL=gpt-4o-mini

# Fallback model used if a call to the primary model fails
AI_FALLBACK_MODEL=gpt-4o-mini

# Timeout for AI API calls in seconds (default: 30)
AI_REQUEST_TIMEOUT_SECONDS=30

# Max retry attempts for a failed AI API call (default: 2)
AI_MAX_RETRIES=2

# How long to cache AI responses in seconds (default: 21600 = 6 hours)
AI_CACHE_TTL_SECONDS=21600

# Max AI requests allowed per hour (default: 100)
AI_RATE_LIMIT_PER_HOUR=100

# Monthly AI spend budget in USD (default: 10.00)
AI_MONTHLY_BUDGET_USD=10.00

# Fraction of AI_MONTHLY_BUDGET_USD at which a warning is logged (0.0-1.0)
AI_BUDGET_WARNING_THRESHOLD=0.80

# Block further AI calls once the monthly budget is exhausted
AI_BUDGET_HARD_STOP=true

# Enable the AI lead-prioritization feature
AI_FEATURE_LEAD_PRIORITIZATION=true

# Enable the AI daily-briefing feature
AI_FEATURE_DAILY_BRIEFING=false

# Enable the AI natural-language query feature
AI_FEATURE_NATURAL_QUERY=false

# ─── CRM Stage IDs ────────────────────────────────────────────────────────────
# Comma-separated stage IDs — these are Odoo database IDs that may differ
# between instances. Verify against your Odoo: Settings > CRM > Stages.

# Stages that count as critical when overdue
# (New Lead, Qualified, Proposal Sent, Negotiation, Contract Sent)
CRM_CRITICAL_STAGE_IDS=28,34,35,37,41

# Stages excluded from overdue tracking (closed/terminal stages)
# (Closed Won, Closed Lost, Closed Duplicate, Closed Invalid,
#  Closed No Answer, Closed Cancelled, Closed Transferred)
CRM_CLOSED_EXCLUDED_STAGE_IDS=26,30,31,32,38,42,46
